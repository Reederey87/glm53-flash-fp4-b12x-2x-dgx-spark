[Unit]
Description=Restore B12X during the guarded Flare production/reboot window
ConditionPathExists=/home/nvidia/b12x-flare/local/production-pending.json

[Service]
Type=oneshot
Environment=HOME=/home/nvidia
WorkingDirectory=/home/nvidia/b12x-flare
ExecStart=/bin/bash /home/nvidia/b12x-flare/scripts/flare_production_rollback.sh
TimeoutStartSec=1800
