[Unit]
Description=Reviewed recipe A/B window %i with independent rollback

[Service]
Type=exec
WorkingDirectory=/home/nvidia/b12x
Environment=PATH=/home/nvidia/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /home/nvidia/b12x/scripts/recipe_window.sh %i
ExecStopPost=/bin/bash /home/nvidia/b12x/scripts/recipe_recover.sh %i
KillMode=mixed
TimeoutStopSec=3600
StandardOutput=append:/home/nvidia/b12x/local/ab-%i/window.log
StandardError=append:/home/nvidia/b12x/local/ab-%i/window.log
