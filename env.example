# ============================================================================
# b12x kit — GLM-5.3-Flash-FP4-Local on 2x DGX Spark
# ============================================================================
# Copy to .env and edit. `launch.sh` sources this file; caller exports win
# only for the keys listed in launch.sh's capture whitelist.
#
# Pinned facts (verified in receipts/qualification.txt):
#   checkpoint  nvidia/GLM-5.3-Flash-FP4-Local @ 76348ddb2be2e35e39ecfc00e75dc07703f4f3d5
#   image       vllm-node-b12x (local, built from eugr/spark-vllm-b12x)
#   flashinfer  0.7.1 @ 91271757 (b12x vendored under flashinfer/experimental/b12x)
#   engine      vLLM 0.1.dev21830+g8244d1c44.d20261103 (B12X backends)
#   launcher    eugr/spark-vllm-docker @ 0bdc9c94cd89843e1c8f7d7b33df2d5bc746c03d
# ============================================================================

# --- cluster ----------------------------------------------------------------
# Head is the rendezvous + API node; worker is reached from the head as the
# same user over the QSFP rail (ssh nvidia@192.168.177.11).
CLUSTER_NODES="192.168.177.10,192.168.177.11"
HEAD_IP="192.168.177.10"
WORKER_IP="192.168.177.11"
ETH_IF="enp1s0f1np1"
IB_IF="rocep1s0f1,roceP2p1s0f1"
COPY_HOSTS="192.168.177.11"
MASTER_PORT="29501"
CONTAINER_NAME="vllm_node"

# --- image ------------------------------------------------------------------
# PULL_IMAGE=0 keeps the pinned local image; the tag must already exist on both
# nodes. The build lane is documented in docs/00-architecture.md § Image.
IMAGE_REF="eugr/spark-vllm-b12x:nightly-20261015"
IMAGE_TAG="vllm-node-b12x"
PULL_IMAGE="0"

# --- launcher ---------------------------------------------------------------
SPARK_VLLM_REF="0bdc9c94cd89843e1c8f7d7b33df2d5bc746c03d"
SPARK_VLLM_DIR=".vendor/spark-vllm-docker"

# --- serving ----------------------------------------------------------------
# 1M context, 17 GiB FP8 KV per rank. On this image that is ~2.35M tokens
# (2.35x at 1M) — four 500k requests or two full 1M requests.
PORT="8000"
HOST="127.0.0.1"
MAX_MODEL_LEN="1000000"
MAX_NUM_SEQS="4"
MAX_NUM_BATCHED_TOKENS="4096"
KV_CACHE_BYTES="17G"
NUM_SPECULATIVE_TOKENS="5"
GPU_MEMORY_UTILIZATION="0.87"

# --- reasoning --------------------------------------------------------------
# "max" is the checkpoint contract for requests that omit reasoning_effort:
# the chat template writes `<|system|>Reasoning Effort: Max` before the first
# message. `scripts/verify_reasoning.py` asserts this on every smoke.
DEFAULT_REASONING_EFFORT="max"

# --- operations -------------------------------------------------------------
HF_TOKEN=""
TAIL="200"
