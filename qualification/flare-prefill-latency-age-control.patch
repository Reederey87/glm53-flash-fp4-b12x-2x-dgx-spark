+    /// Rank eligible prompts by arrival time plus estimated remaining service.
+    /// Subtracting now from every key gives remaining service minus request age.
+    /// Unlike pure shortest-remaining-work, an old prompt can outrank continually
+    /// arriving short prompts. With bounded positive cost estimates and finite
+    /// active slots it eventually wins prompt service; this is not a wall-clock
+    /// deadline or a guarantee under arbitrary decode overload.
+    ///
+    /// Use one shared full-chunk estimate for all request/shape choices. Unknown
+    /// timing retains the original discovery policy. Only cohort membership
+    /// changes: graph cost, token prices, decode/terminal competition, feedback
+    /// barriers and refresh budgets remain the existing scheduler's decisions.
+    fn completion_prefill(&self, kind: GraphKind, offers: &[(usize, f64)]) -> Option<u64> {
+        let (capacity, duration) = self.prefill_catalog(kind).iter().rev()
+            .find_map(|&capacity| self.costs.duration(kind, 1, capacity)
+                .filter(|&duration| duration > 0).map(|duration| (capacity, duration)))?;
+        let selected = offers.iter().map(|&(slot, _)| slot).min_by_key(|&slot| {
+            let request = self.slots[slot].request.as_ref().unwrap();
+            let remaining = (request.prompt_tokens as u64).saturating_sub(request.scheduled_consumed);
+            let arrival = request.accounting.arrival_ns;
+            // Integer cross-multiplication avoids dividing or rounding short tails.
+            let virtual_finish = u128::from(arrival) * capacity as u128
+                + u128::from(remaining) * u128::from(duration);
+            (virtual_finish, arrival, slot)
+        })?;
+        Some(1u64 << selected)
+    }
