@@ -0,0 +1,260 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Flare community contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+use super::{Dashboard, Metrics, Telemetry};
+use crate::server::{metrics::scheduler::TRACE_CAPACITY, observation::monotonic_ns};
+use serde_json::{Value, json};
+use std::{
+    collections::VecDeque,
+    fs::OpenOptions,
+    io::{self, BufWriter, Write},
+    path::Path,
+    sync::{Arc, atomic::Ordering, mpsc::{self, Receiver, RecvTimeoutError}},
+    thread,
+    time::{Duration, Instant},
+};
+
+const MAX_BYTES: usize = 16 * 1024 * 1024;
+const MAX_COMPLETIONS: usize = 16_384;
+const MAX_DURATION: Duration = Duration::from_secs(600);
+const FOOTER_RESERVE: usize = 4096;
+
+struct Output<W> {
+    writer: W,
+    bytes: usize,
+    limit: usize,
+}
+
+impl<W: Write> Output<W> {
+    fn record(&mut self, value: Value) -> io::Result<bool> {
+        let mut bytes = serde_json::to_vec(&value)?;
+        bytes.push(b'\n');
+        if bytes.len() > self.limit.saturating_sub(FOOTER_RESERVE).saturating_sub(self.bytes) {
+            return Ok(false);
+        }
+        self.writer.write_all(&bytes)?;
+        self.bytes += bytes.len();
+        Ok(true)
+    }
+
+    fn finish(&mut self, value: Value) -> io::Result<()> {
+        let mut bytes = serde_json::to_vec(&value)?;
+        bytes.push(b'\n');
+        if bytes.len() > self.limit.saturating_sub(self.bytes) {
+            return Err(io::Error::other("scheduler trace footer exceeds its byte bound"));
+        }
+        self.writer.write_all(&bytes)?;
+        self.writer.flush()
+    }
+}
+
+impl Dashboard {
+    pub(in crate::server) fn capture(metrics: Arc<Metrics>, path: &Path) -> io::Result<Self> {
+        let mut options = OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(path)?;
+        let mut output = Output { writer: BufWriter::new(file), bytes: 0, limit: MAX_BYTES };
+        let catalog = metrics.scheduler_trace.catalog.get()
+            .ok_or_else(|| io::Error::other("scheduler graph catalog is not initialized"))?;
+        let graphs: Vec<_> = catalog.iter().enumerate().map(|(index, g)| json!({
+            "graph": index, "name": g.name, "kind": format!("{:?}", g.kind),
+            "batch_capacity": g.batch, "token_capacity": g.tokens,
+            "prefill_capacity": g.prefill, "packed_token_capacity": g.packed,
+        })).collect();
+        if !output.record(json!({"event": "manifest", "schema": 1,
+            "clock": "server monotonic nanoseconds", "started_at_ns": monotonic_ns(),
+            "scope": "native graph completion observations; not GPU start/end timestamps",
+            "max_seconds": MAX_DURATION.as_secs(), "max_bytes": MAX_BYTES,
+            "max_completions": MAX_COMPLETIONS, "poll_interval_ms": 5000, "graphs": graphs,
+        }))? {
+            return Err(io::Error::other("scheduler graph catalog exceeds trace byte bound"));
+        }
+        output.writer.flush()?;
+        let (stop, receiver) = mpsc::channel();
+        let dropped_before = (metrics.scheduler_trace.dropped.load(Ordering::Relaxed),
+                              metrics.scheduler_trace.dropped_completions.load(Ordering::Relaxed));
+        metrics.scheduler_trace.start();
+        let observed = metrics.clone();
+        let thread = thread::Builder::new().name("flare-scheduler-capture".into()).spawn(move || {
+            let _telemetry = Telemetry(&observed);
+            if let Err(error) = collect(&observed, &mut output, receiver, MAX_DURATION,
+                                       MAX_COMPLETIONS, dropped_before) {
+                // An absent footer makes an I/O failure incomplete evidence.
+                eprintln!("Scheduler trace failed: {error}");
+            }
+        });
+        match thread {
+            Ok(thread) => Ok(Self { stop, thread: Some(thread) }),
+            Err(error) => { metrics.scheduler_trace.stop(); Err(error) }
+        }
+    }
+}
+
+fn collect<W: Write>(metrics: &Metrics, output: &mut Output<W>, stop: Receiver<()>,
+                     duration: Duration, limit: usize, dropped_before: (u64, u64)) -> io::Result<()> {
+    let started = Instant::now();
+    let mut samples = VecDeque::with_capacity(TRACE_CAPACITY);
+    let mut completions = 0;
+    let mut reason = "duration";
+    let mut truncated = false;
+    loop {
+        let remaining = duration.saturating_sub(started.elapsed());
+        let stopping = if remaining.is_zero() { true } else {
+            match stop.recv_timeout(remaining.min(Duration::from_secs(5))) {
+                Ok(()) | Err(RecvTimeoutError::Disconnected) => { reason = "stopped"; true }
+                Err(RecvTimeoutError::Timeout) => started.elapsed() >= duration,
+            }
+        };
+        if stopping { metrics.scheduler_trace.stop(); }
+        let (detail, _) = metrics.scheduler_trace.drain(&mut samples);
+        for sample in samples.drain(..) {
+            if completions >= limit { truncated = true; break; }
+            let lanes: Vec<_> = sample.generations.iter().enumerate()
+                .filter(|(_, generation)| **generation != 0)
+                .map(|(slot, generation)| json!({"slot": slot, "generation": generation,
+                    "start_position": sample.start_positions[slot], "tokens": sample.token_counts[slot]}))
+                .collect();
+            if !output.record(json!({"event": "completion", "at_ns": sample.at_ns,
+                "fence": sample.fence.0, "graph": sample.graph, "lanes": lanes,
+                "gpu_ns": sample.gpu_ns, "wall_ns": sample.wall_ns, "queued": sample.queued,
+                "selected_at_ns": sample.selection.selected_at_ns,
+                "commit_ns": sample.selection.commit_ns, "estimate_ns": sample.selection.retained_ns,
+                "timing_origin": format!("{:?}", sample.selection.origin),
+            }))? { truncated = true; break; }
+            completions += 1;
+        }
+        let requests: Vec<_> = detail.requests.iter().flatten().map(|r| json!({
+            "slot": r.handle.slot, "generation": r.handle.generation,
+            "phase": format!("{:?}", r.phase), "consumed": r.consumed,
+            "prompt": r.prompt, "generated": r.generated,
+            "last_progress_ns": r.last_progress_ns, "last_output_ns": r.last_output_ns,
+            "published_deliveries": r.published_deliveries,
+        })).collect();
+        if !truncated && !output.record(json!({"event": "state", "sampled_at_ns": detail.at_ns,
+            "observed_at_ns": monotonic_ns(), "outstanding": detail.outstanding, "requests": requests}))? {
+            truncated = true;
+        }
+        output.writer.flush()?;
+        if stopping || truncated { break; }
+    }
+    metrics.scheduler_trace.stop();
+    let dropped = metrics.scheduler_trace.dropped.load(Ordering::Relaxed).saturating_sub(dropped_before.0);
+    let dropped_completions = metrics.scheduler_trace.dropped_completions.load(Ordering::Relaxed)
+        .saturating_sub(dropped_before.1);
+    output.finish(json!({"event": "complete", "at_ns": monotonic_ns(),
+        "completions": completions, "dropped_updates": dropped, "truncated": truncated,
+        "dropped_completions": dropped_completions,
+        "dropped_other_updates": dropped.saturating_sub(dropped_completions),
+        "reason": if truncated { "limit" } else { reason },
+        "complete": !truncated && dropped == 0,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{cache::Fence, execution::{ExecutionTiming, GraphKind},
+        scheduler::{RequestHandle, ScheduledLane, ScheduledStep, SubmittedTiming}};
+
+    fn fixture(count: usize) -> Metrics {
+        let metrics = Metrics::default();
+        metrics.scheduler_trace.start();
+        for n in 0..count {
+            let step = ScheduledStep { draft_tokens: 0, packed_token_capacity: 0,
+                kind: GraphKind::Prefill, batch_capacity: 1, token_capacity: 4096,
+                mixed: None, requires_feedback: true,
+                lanes: vec![ScheduledLane { request: RequestHandle { slot: 3, generation: 9 },
+                    start_position: n as u64 * 4096, tokens: 4096 }],
+            };
+            metrics.scheduler_trace.completed(n as u64 + 10, Fence(n as u64 + 1), 2,
+                &step, ExecutionTiming::default(), SubmittedTiming::default(), 0.);
+        }
+        metrics
+    }
+
+    fn record(metrics: &Metrics, limit: usize, bytes: usize) -> Vec<Value> {
+        let (stop, receiver) = mpsc::channel();
+        stop.send(()).unwrap();
+        let mut output = Output { writer: Vec::new(), bytes: 0, limit: bytes };
+        collect(metrics, &mut output, receiver, Duration::from_secs(1), limit, (0, 0)).unwrap();
+        String::from_utf8(output.writer).unwrap().lines()
+            .map(|line| serde_json::from_str(line).unwrap()).collect()
+    }
+
+    #[test]
+    fn capture_retains_order_generations_and_final_batch() {
+        let rows = record(&fixture(3), 100, MAX_BYTES);
+        let completions: Vec<_> = rows.iter().filter(|r| r["event"] == "completion").collect();
+        assert_eq!(completions.len(), 3);
+        for (n, row) in completions.iter().enumerate() {
+            assert_eq!(row["fence"], n + 1);
+            assert_eq!(row["lanes"], json!([{"slot":3,"generation":9,"start_position":n*4096,"tokens":4096}]));
+        }
+        let footer = rows.last().unwrap();
+        assert_eq!(footer["complete"], true);
+        assert_eq!(footer["reason"], "stopped");
+    }
+
+    #[test]
+    fn capture_overflow_and_output_limits_are_incomplete() {
+        for (count, limit, bytes) in [(TRACE_CAPACITY + 1, 2000, MAX_BYTES),
+                                     (3, 2, MAX_BYTES), (3, 100, FOOTER_RESERVE)] {
+            let rows = record(&fixture(count), limit, bytes);
+            assert_eq!(rows.last().unwrap()["complete"], false);
+        }
+    }
+
+    #[test]
+    fn capture_distinguishes_completion_loss_without_waiving_other_loss() {
+        let metrics = fixture(3);
+        metrics.scheduler_trace.dropped.fetch_add(1, Ordering::Relaxed);
+        let rows = record(&metrics, 100, MAX_BYTES);
+        let footer = rows.last().unwrap();
+        assert_eq!(footer["complete"], false);
+        assert_eq!(footer["dropped_completions"], 0);
+        assert_eq!(footer["dropped_other_updates"], 1);
+        let rows = record(&fixture(TRACE_CAPACITY + 1), 2000, MAX_BYTES);
+        let footer = rows.last().unwrap();
+        assert_eq!(footer["complete"], false);
+        assert_eq!(footer["dropped_completions"], 1);
+        assert_eq!(footer["dropped_other_updates"], 0);
+    }
+
+    #[test]
+    fn capture_reports_io_failure_without_a_success_footer() {
+        struct Broken;
+        impl Write for Broken {
+            fn write(&mut self, _: &[u8]) -> io::Result<usize> { Err(io::Error::other("write failed")) }
+            fn flush(&mut self) -> io::Result<()> { Ok(()) }
+        }
+        let (_sender, receiver) = mpsc::channel();
+        let mut output = Output { writer: Broken, bytes: 0, limit: MAX_BYTES };
+        assert!(collect(&fixture(1), &mut output, receiver, Duration::ZERO, 100, (0, 0)).is_err());
+    }
+
+    #[test]
+    fn capture_file_is_exclusive_and_stops_with_its_owner() {
+        let path = std::env::temp_dir().join(format!("flare-trace-{}-{}.jsonl", std::process::id(), monotonic_ns()));
+        let metrics = Arc::new(Metrics::default());
+        metrics.scheduler_trace.catalog.set(Vec::new()).ok().unwrap();
+        let capture = Dashboard::capture(metrics.clone(), &path).unwrap();
+        let before = std::fs::read(&path).unwrap();
+        assert!(Dashboard::capture(metrics.clone(), &path).is_err());
+        assert!(std::fs::read(&path).unwrap().starts_with(&before));
+        drop(capture);
+        let rows: Vec<Value> = std::fs::read_to_string(&path).unwrap().lines()
+            .map(|line| serde_json::from_str(line).unwrap()).collect();
+        assert_eq!(rows.first().unwrap()["event"], "manifest");
+        assert_eq!(rows.last().unwrap()["complete"], true);
+        assert!(!metrics.scheduler_trace.detail_requested.load(Ordering::Relaxed));
+        std::fs::remove_file(path).unwrap();
+    }
+}
