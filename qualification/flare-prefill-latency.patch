@@ -0,0 +1,219 @@
+//! CPU regressions for completion-oriented prompt selection and bounded promotion.
+use super::*;
+
+fn trace(policy: PolicyConfig, lengths: &[usize]) -> (Vec<usize>, Vec<usize>) {
+    let mut s = interactive_engine(lengths.len(), false);
+    s.configure_policy(policy).unwrap();
+    let handles: Vec<_> = lengths.iter().enumerate()
+        .map(|(i, &length)| add(&mut s, i as u32 + 1, length, 1)).collect();
+    let mut order = Vec::new();
+    let mut first_chunk = vec![0; lengths.len()];
+    let mut chunks = 0;
+    for _ in 0..1024 {
+        if handles.iter().all(|&h| s.request(h).is_err()) { break; }
+        let plan = step(&mut s, 0);
+        if plan.kind.is_prefill() { chunks += 1; }
+        for (i, &handle) in handles.iter().enumerate() {
+            if first_chunk[i] == 0 && s.request(handle).is_ok_and(|r| r.generated_tokens > 0) {
+                first_chunk[i] = chunks;
+                order.push(i);
+            }
+        }
+    }
+    assert!(handles.iter().all(|&h| s.request(h).is_err()), "all requests must retire");
+    assert!(first_chunk.iter().all(|&n| n > 0));
+    (order, first_chunk)
+}
+
+#[test]
+fn equal_long_prompts_complete_earlier_without_extra_prompt_work() {
+    for count in [1, 2, 4] {
+        let lengths = vec![32768; count];
+        let (_, balanced) = trace(PolicyConfig::default(), &lengths);
+        let (order, latency) = trace(PolicyConfig::latency(), &lengths);
+        assert_eq!(order, (0..count).collect::<Vec<_>>());
+        assert_eq!(latency, (1..=count).map(|i| i * 8).collect::<Vec<_>>());
+        assert_eq!(*latency.last().unwrap(), count * 8);
+        if count > 1 { assert!(latency[0] < balanced[0]); }
+        println!("PREFILL_LATENCY count={count} balanced_chunks={balanced:?} latency_chunks={latency:?}");
+    }
+}
+
+#[test]
+fn unequal_prompts_favor_less_remaining_work() {
+    let (order, _) = trace(PolicyConfig::latency(), &[32768, 4096, 8192, 16384]);
+    assert_eq!(order, vec![1, 2, 3, 0]);
+}
+
+#[test]
+fn continuing_short_arrivals_do_not_starve_an_old_long_prompt() {
+    let mut s = interactive_engine(4, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    let long = add(&mut s, 1, 32768, 1);
+    let mut short = Vec::new();
+    let mut admitted = 0;
+    let mut first_progress = None;
+    for _ in 0..4096 {
+        if s.request(long).is_err() { break; }
+        short.retain(|&h| s.request(h).is_ok());
+        while short.len() < 3 {
+            admitted += 1;
+            // Distinct contents avoid prefix reuse in this scheduling test.
+            short.push(add(&mut s, 1 + admitted, 64, 1));
+        }
+        step(&mut s, 0);
+        if first_progress.is_none() && s.request(long).is_ok_and(|r| r.consumed_tokens > 0) {
+            first_progress = Some(s.now_ns);
+        }
+    }
+    assert!(admitted >= 8, "exercise sustained arrivals, not one fixed batch");
+    assert!(first_progress.is_some_and(|ns| ns < 2_000 * MS));
+    assert!(s.request(long).is_err(), "old long request must finish despite short arrivals");
+    assert!(s.now_ns < 4_000 * MS, "synthetic service bound: {}", s.now_ns);
+    for h in short { if s.request(h).is_ok() { s.cancel(h).unwrap(); } }
+    for _ in 0..64 {
+        if s.slots.iter().all(|slot| slot.request.is_none()) { break; }
+        step(&mut s, 0);
+    }
+    assert!(s.slots.iter().all(|slot| slot.request.is_none()));
+}
+
+#[test]
+fn cancelled_favored_prompt_does_not_block_remaining_requests() {
+    let mut s = interactive_engine(2, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    let cancelled = add(&mut s, 1, 8192, 1);
+    let remaining = add(&mut s, 2, 32768, 1);
+    for _ in 0..16 {
+        let plan = step(&mut s, 0);
+        if plan.kind.is_prefill() && plan.lanes[0].request == cancelled { break; }
+    }
+    assert!(s.request(cancelled).unwrap().consumed_tokens > 0);
+    s.cancel(cancelled).unwrap();
+    for _ in 0..128 {
+        if s.slots.iter().all(|slot| slot.request.is_none()) { break; }
+        step(&mut s, 0);
+    }
+    assert!(s.request(cancelled).is_err());
+    assert!(s.request(remaining).is_err());
+}
+
+#[test]
+fn unmeasured_prompt_shapes_retain_discovery_and_make_progress() {
+    let mut s = interactive_engine(2, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    for capacity in [64, 128, 256, 512, 1024, 2048, 4096] {
+        set_cost(&mut s, GraphKind::Prefill, 1, capacity, 0);
+    }
+    let handles = [add(&mut s, 1, 4096, 1), add(&mut s, 2, 8192, 1)];
+    for _ in 0..256 {
+        if handles.iter().all(|&h| s.request(h).is_err()) { break; }
+        let plan = s.plan().expect("unknown estimates must not block discovery");
+        let duration = if plan.kind.is_prefill() { (2 + plan.token_capacity as u64 / 64) * MS }
+            else { plan.estimated_duration_ns().max(MS / 10) };
+        let fence = Fence(s.submitted.0 + 1);
+        s.commit(&plan, fence).unwrap();
+        s.advance_to(s.now_ns + duration).unwrap();
+        complete_timed(&mut s, &plan, fence, 0, true, gpu_time(duration));
+    }
+    assert!(handles.iter().all(|&h| s.request(h).is_err()));
+}
+
+// Regression oracles shared by the original-policy control and bounded candidate.
+#[test]
+fn late_short_arrival_does_not_wait_for_older_long_completion() {
+    let mut s = interactive_engine(2, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    let long = add(&mut s, 1, 32768, 1);
+    for _ in 0..128 {
+        if s.request(long).unwrap().consumed_tokens >= 16384 { break; }
+        step(&mut s, 0);
+    }
+    assert_eq!(s.request(long).unwrap().consumed_tokens, 16384);
+    let short = add(&mut s, 2, 64, 1);
+    let arrival = s.now_ns;
+    for _ in 0..128 {
+        if s.request(short).is_err() { break; }
+        step(&mut s, 0);
+    }
+    assert!(s.request(short).is_err());
+    let long_consumed = s.request(long).map_or(32768, |r| r.consumed_tokens);
+    println!("LATE_SHORT wait_ns={} long_consumed={long_consumed}", s.now_ns - arrival);
+    assert!(long_consumed < 32768, "new short work waited for old long completion");
+}
+
+#[test]
+fn active_decode_preserves_balanced_prefill_competition() {
+    fn choices(completion: bool) -> Vec<(GraphKind, usize, usize, Vec<u32>)> {
+        let mut s = interactive_engine(4, true);
+        let decoders = [add(&mut s, 1, 128, 4096), add(&mut s, 2, 128, 4096)];
+        ready(&mut s, &decoders);
+        // Test-only same-state comparison; no production hot-reconfiguration API.
+        s.policy.prefill_completion = completion;
+        let prompts = [add(&mut s, 3, 32768, 1), add(&mut s, 4, 4096, 1)];
+        let mut result = Vec::new();
+        for _ in 0..1024 {
+            if prompts.iter().all(|&h| s.request(h).is_err()) { break; }
+            assert!(decoders.iter().all(|&h| s.request(h).is_ok()));
+            let plan = step(&mut s, 2);
+            result.push((plan.kind, plan.token_capacity, plan.batch_capacity,
+                         plan.lanes.iter().map(|l| l.request.slot).collect()));
+        }
+        assert!(prompts.iter().all(|&h| s.request(h).is_err()));
+        result
+    }
+    let balanced = choices(false);
+    let latency = choices(true);
+    let first = balanced.iter().zip(&latency).position(|(a, b)| a != b)
+        .unwrap_or(balanced.len().min(latency.len()));
+    assert!(balanced == latency, "active decode choices differ at {first}: {:?} vs {:?}",
+            balanced.get(first), latency.get(first));
+}
+
+#[test]
+fn bypass_counts_prompt_completions_not_chunks_and_resets_on_progress() {
+    let mut s = interactive_engine(2, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    let long = add(&mut s, 1, 32768, 1);
+    let short = add(&mut s, 2, 8192, 1);
+    for _ in 0..64 {
+        if s.request(short).unwrap().consumed_tokens >= 4096 { break; }
+        step(&mut s, 0);
+    }
+    assert_eq!(s.request(short).unwrap().consumed_tokens, 4096);
+    assert_eq!(s.request(long).unwrap().accounting.prefill_bypasses, 0);
+    for _ in 0..64 {
+        if s.request(short).unwrap().consumed_tokens == 8192 { break; }
+        step(&mut s, 0);
+    }
+    assert_eq!(s.request(long).unwrap().accounting.prefill_bypasses, 1);
+    for _ in 0..64 {
+        if s.request(long).unwrap().consumed_tokens > 0 { break; }
+        step(&mut s, 0);
+    }
+    assert!(s.request(long).unwrap().consumed_tokens > 0);
+    assert_eq!(s.request(long).unwrap().accounting.prefill_bypasses, 0);
+}
+
+#[test]
+fn cancelled_slot_does_not_transfer_prefill_promotion_debt() {
+    let mut s = interactive_engine(2, false);
+    s.configure_policy(PolicyConfig::latency()).unwrap();
+    let old = add(&mut s, 1, 32768, 1);
+    let short = add(&mut s, 2, 64, 1);
+    for _ in 0..64 {
+        if s.request(short).unwrap().consumed_tokens == 64 { break; }
+        step(&mut s, 0);
+    }
+    assert_eq!(s.request(old).unwrap().accounting.prefill_bypasses, 1);
+    s.cancel(old).unwrap();
+    for _ in 0..64 {
+        if s.slots.iter().all(|slot| slot.request.is_none()) { break; }
+        step(&mut s, 0);
+    }
+    assert!(s.slots.iter().all(|slot| slot.request.is_none()));
+    let fresh = add(&mut s, 3, 4096, 1);
+    assert_eq!(fresh.slot, old.slot);
+    assert_ne!(fresh.generation, old.generation);
+    assert_eq!(s.request(fresh).unwrap().accounting.prefill_bypasses, 0);
+}
